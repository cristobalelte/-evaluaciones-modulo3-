<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AMA" parent="android:Theme.Material.Light.NoActionBar" />
    <!--    Creamos el nuevo theme para el splashscreen llamamdo: App.Starting -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_start_foreground</item>
        <item name="windowSplashScreenAnimationDuration">2000</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/purple_200</item>
        <item name="postSplashScreenTheme">@style/Theme.AMA</item>
    </style>
</resources>